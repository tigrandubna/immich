# Reference env for the standalone stack. The desktop app generates a real .env
# from this template next to docker-compose.standalone.yml.

# Where photos uploaded via the UI and the Postgres data live (inside the Colima VM).
UPLOAD_LOCATION=./library

# Which published image tag to run (matches a standalone-vX.Y.Z release, or `dev`).
IMMICH_TAG=latest

# Timezone inside the containers.
TZ=Europe/Moscow

# Change to a random A-Za-z0-9 string.
DB_PASSWORD=postgres

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
